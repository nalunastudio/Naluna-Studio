# Stocare fisiere media — Cloudflare R2 sau AWS S3, in DOUA bucket-uri separate.
# FARA acestea setate, aplicatia foloseste automat discul local ca fallback — util pentru
# testare, dar NU recomandat pe Railway pentru productie (fisierele se pierd la redeploy).
# Pasii de configurare exacti, pentru R2 si pentru S3, sunt in comentariile din storage.js.
#
# S3_PRIVATE_BUCKET — DOAR melodiile complete. Fara acces public, niciodata. Acces exclusiv
# prin URL semnat (presigned), generat dupa ce clientul a platit.
S3_PRIVATE_BUCKET=naluna-private
#
# S3_PUBLIC_BUCKET — preview-uri si reactii clienti (testimoniale). Acces public, prin
# Custom Domain Cloudflare (vezi S3_PUBLIC_BASE_URL mai jos).
S3_PUBLIC_BUCKET=naluna-public
#
# Acelasi API token (Access Key + Secret) poate avea acces la ambele bucket-uri —
# le creezi o singura data, cu scop "Apply to specific buckets" -> selectezi ambele.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=auto
#
# URL-ul public (Custom Domain) al bucket-ului S3_PUBLIC_BUCKET — NU al celui privat.
# Bucket-ul privat nu are niciodata un URL public.
S3_PUBLIC_BASE_URL=https://media.nalunastudio.com

# Baza de date PostgreSQL — pe Railway se injecteaza AUTOMAT cand adaugi
# un serviciu PostgreSQL din dashboard (New -> Database -> PostgreSQL).
# Local: postgres://user:parola@localhost:5432/nume_baza
DATABASE_URL=postgres://user:parola@localhost:5432/nota_de_suflet

# Stripe (dashboard.stripe.com -> Developers -> API keys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# TVA automat (Stripe Tax) — ramane FALSE implicit. Nu schimba in "true" decat dupa ce ai
# activat Stripe Tax din Dashboard-ul Stripe SI ai verificat/inregistrat obligatiile fiscale
# relevante pentru tarile in care vinzi. Cand e "true", automatic_tax se activeaza in
# Checkout Session; cand e "false" (sau lipseste), ramane dezactivat.
STRIPE_AUTOMATIC_TAX_ENABLED=false

# Domeniul unde e publicat site-ul (fara slash la final)
DOMAIN=https://nalunastudio.com

# Provider API de generare muzica — SunoAPI.org (integrare confirmata, vezi server.js)
MUSIC_API_BASE_URL=https://api.sunoapi.org
MUSIC_API_KEY=...
# Optional — modelul Suno folosit la generare. Daca lipseste, ramane V4_5ALL (comportamentul
# de dintotdeauna). Valori acceptate de furnizor (verificat direct in documentatia oficiala
# sunoapi.org): V4, V4_5, V4_5PLUS, V4_5ALL, V5, V5_5.
# CORECTIE (2026-09-07, diagnostic performanta real): V4_5ALL masurat consistent >120s in
# productie (232s/257s reale + 140.7s control) — schimbat in productie la V4_5, masurat PASS
# consistent sub 120s (77.1s/57.5s/57.5s, 3 teste reale) cu calitate audio confirmata acceptabila
# printr-un test orb A/B/C (V4_5ALL/V4_5/V5, normalizate identic la loudness). V5 a fost de
# asemenea PASS (70.6s) dar cu mai putine teste de consistenta si un motor intern mai diferit
# de actualul V4_5ALL (chirp-crow vs chirp-auk/chirp-auk-turbo) — V4_5 ales ca migrare mai mica.
MUSIC_MODEL=V4_5

# Sistem de protectie a creditelor Suno (vezi credits.js) — toate optionale, cu valori
# implicite verificate direct impotriva contului real (2026-08-02): un apel de generare
# (model V4_5ALL) costa exact 12 credite, o comanda normala foloseste 1 sau 2 apeluri.
# CREDITS_PER_ORDER_ESTIMATE=24
# CREDIT_SAFETY_RESERVE_ORDERS=10
# MAX_GENERATION_ATTEMPTS=4
# Optional — daca setat, trimite un email real (prin Resend) la fiecare prag nou de alerta
# (30%/15%/10%/5% din balanta de referinta). Fara el, alertele raman doar in log-urile Railway.
# ADMIN_ALERT_EMAIL=admin@nalunastudio.com
# Prag FIX (in credite) pentru alerta principala "Naluna Alert: Credits Reached N" — separat
# de pragurile procentuale de mai sus. Starea armat/dezarmat e persistenta in Postgres
# (credit_alert_state), niciodata doar in memorie — vezi db.claimCreditAlertTransition.
# CREDIT_ALERT_THRESHOLD=248

# Email de livrare (resend.com - cont gratuit pana la 3000 emailuri/luna)
RESEND_API_KEY=re_...
# Doar adresa (fara nume) — codul adauga automat afisarea "Naluna Studio <adresa>" ca nume
# de expeditor vizibil clientului, pastrand aceasta adresa neschimbata.
RESEND_FROM_EMAIL=comenzi@domeniul-tau.ro

# Webhook Resend (bounce/complaint handling, launch safety Faza 6) — SEPARAT de RESEND_API_KEY.
# Se creeaza manual din dashboard-ul Resend (nu poate fi creat prin API cu o cheie "Sending
# access"): Webhooks -> Add Webhook -> URL: https://domeniul-tau.com/api/resend/webhook ->
# selecteaza STRICT evenimentele "email.bounced" si "email.complained" -> dupa creare, Resend
# afiseaza o valoare "Signing Secret" (incepe cu "whsec_") -> copiaz-o aici.
RESEND_WEBHOOK_SECRET=whsec_...

# Login owner - acces la /admin (panou comenzi si venit)
ADMIN_USER=admin
ADMIN_PASSWORD=schimba-parola-asta

# CORECȚIE (2026-08-30): limita de durata a fost eliminata complet (nu mai exista niciun plafon
# artificial de secunde pentru un videoclip incarcat de client) — ORDER_MEDIA_MAX_VIDEO_SECONDS
# nu mai e citita de server.js.

# Optional — dimensiunea maxima acceptata (in MB) per fotografie/videoclip incarcat de client
# la pachetul "Cadou video" (vezi ORDER_MEDIA_MAX_BYTES in server.js). Implicit — limita TEHNICA
# reala a upload-ului multipart catre R2 (marimea unei parti x numarul maxim de parti permis de
# serviciu, ~97.6GB), nu o valoare de business aleasa arbitrar.
# ORDER_MEDIA_MAX_MB=700

# Analytics (2026-09-14) — Google Analytics 4. Ambele optionale — fara ele, analytics.js nu
# incarca nimic (bannerul de consimtamant tot apare, dar acceptarea lui nu are niciun efect
# vizibil) si evenimentul server-side "purchase" e omis silentios (Stripe/DB raman oricum sursa
# de adevar pentru plata reala, neafectate).
# GA_MEASUREMENT_ID: public, din GA4 -> Admin -> Data Streams -> stream-ul web -> "Measurement ID"
# (format G-XXXXXXXXXX) — servit clientilor prin GET /js/config.js, niciodata hardcodat.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# GA_API_SECRET: STRICT server-side, folosit doar pentru evenimentul "purchase" prin Measurement
# Protocol (vezi sendGa4PurchaseEvent, server.js) — din GA4 -> Admin -> Data Streams -> stream-ul
# web -> "Measurement Protocol API secrets" -> Create. NICIODATA expus clientilor.
# GA_API_SECRET=...

# ANALYTICS_EXCLUDED_EMAILS (2026-09-18, Funnel Analytics) — comenzi de TEST ale echipei,
# excluse STRICT din KPI-urile comerciale agregate (Dashboard /admin/orders) — niciodata
# sterse din DB, niciodata trimise catre GA4 pentru filtrare. Lista separata prin virgula,
# comparatie exacta (case-insensitive), NICIODATA pattern/domeniu — o adresa care doar "pare"
# de test NU e exclusa automat, trebuie adaugata explicit aici. Optional: variabila lipsa
# inseamna "nicio excludere" (functioneaza identic, fara nicio eroare).
# ANALYTICS_EXCLUDED_EMAILS=nataliaandoni@yahoo.com,ciortancosmin6@gmail.com,marianataliaandoni@gmail.com

# Meta Conversions API (2026-09-21) — evenimentul "Purchase" server-side, STRICT daca clientul a
# bifat consimtamant de marketing la checkout (marketingConsent === 'granted', vezi POST
# /api/orders/:orderId/checkout). Ambele obligatorii impreuna — fara oricare din ele,
# enqueueMetaCapiPurchase (server.js) e no-op silentios (Stripe/DB raman oricum sursa de adevar
# pentru plata reala, neafectate).
# META_CAPI_ACCESS_TOKEN: System User token (Meta Business -> System Users), cu permisiunea
# ads_management. NICIODATA logat/afisat/serializat — vezi lib/meta-capi/capi-client.js
# (trimis STRICT prin header Authorization, niciodata in URL).
# META_CAPI_ACCESS_TOKEN=...
# META_DATASET_ID: ID-ul dataset-ului Meta (Events Manager) catre care se trimit evenimentele
# CAPI (server-side). DISTINCT de META_PIXEL_ID de mai jos — nu confunda cele doua.
# META_DATASET_ID=...
# META_CAPI_TEST_EVENT_CODE: optional — folosit STRICT pentru Meta Test Events (Events Manager
# -> Test Events), niciodata in productie reala. Fara el, evenimentele merg direct ca live.
# META_CAPI_TEST_EVENT_CODE=

# Meta Pixel (2026-09-24, V1 minima — evenimente Meta pre-purchase) — ID PUBLIC prin design
# (ajunge in browser, vezi GET /js/config.js), DISTINCT de META_DATASET_ID de mai sus — cele doua
# NU sunt interschimbabile. Fara el, public/js/analytics.js nu incarca niciun Pixel (identic cu
# comportamentul GA_MEASUREMENT_ID lipsa). Incarcat client-side STRICT dupa consimtamant Marketing
# — vezi loadMetaPixelIfNeeded(), public/js/analytics.js. Purchase ramane STRICT CAPI (mai sus),
# niciun Pixel Purchase.
# META_PIXEL_ID=...

PORT=3000
